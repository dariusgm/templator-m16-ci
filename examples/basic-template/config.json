{
  "name": "my-python-project",
  "description": "A Python project template",
  "variables": {
    "project_name": "my_project",
    "python_version": "3.12",
    "python_version_short": "py312",
    "author": "Darius"
  },
  "post_processing": [
    {
      "type": "replace",
      "file": "pyproject.toml",
      "patterns": [
        { "from": "__AUTHOR__", "to": "Darius" }
      ]
    }
  ]
}
