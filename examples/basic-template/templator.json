{
  "name": "my-python-project",
  "description": "A Python project template",
  "variables": {
    "project_name": {},
    "python_version": { "default": "3.12" },
    "python_version_short": { "default": "py312" },
    "author": { "default": "Anonymous" }
  },
  "post_processing": [
    {
      "type": "replace",
      "file": "pyproject.toml",
      "patterns": [
        { "from": "__AUTHOR__", "to": "{{ author }}" }
      ]
    }
  ]
}
