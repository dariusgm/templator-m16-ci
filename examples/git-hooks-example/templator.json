{
  "name": "rust-project-with-hooks",
  "description": "Rust project with pre-configured git hooks for code quality",
  "variables": {
    "project_name": { "type": "string" },
    "author": { "type": "string", "default": "Anonymous" }
  },
  "exclude": [
    ".git/objects/",
    ".git/refs/",
    ".git/logs/",
    ".git/config",
    ".git/HEAD",
    ".git/description"
  ]
}
