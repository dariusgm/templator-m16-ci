{
  "name": "preserve-sections-demo",
  "description": "Demonstrates preserve_sections for keeping user edits across regenerations",
  "variables": {
    "project_name": { "type": "string" },
    "python_version": { "type": "string", "default": "3.12" },
    "author": { "type": "string", "default": "Anonymous" }
  },
  "post_processing": [
    {
      "type": "preserve_sections",
      "file": "pyproject.toml",
      "begin_marker": "# [preserve:begin]",
      "end_marker": "# [preserve:end]"
    }
  ]
}
